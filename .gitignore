# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
.packages
# pubspec.lock is committed: the generated-types hash covers the supadart
# version it resolves, so every checkout must resolve the same one.

# Generated Dart models (never committed; `devtools db types` or CI makes them)
lib/generated/

# Local configuration. `.env` is public-only; `.env.tooling` holds secrets.
.env
.env.*
!.env.example
.env.tooling

# IDE
*.iml
.idea/

# `devtools db sync` records what a database has had applied here. The schema
# in supabase/schemas is the source of truth; migrations are generated and
# never committed, so a stray `git add .` must not pick them up.
supabase/migrations/
supabase/.temp/
supabase/.branches/

# devtools records which schema hash lib/generated was built from
.devtools/

# `pnpm devtools` is a dlx run and installs nothing, but a stray install
# must not be committed.
node_modules/

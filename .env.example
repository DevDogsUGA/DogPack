# The app's public configuration. `pnpm devtools setup` copies
# this to `.env`, fills in your own Supabase project, and the app reads it:
#
#   flutter run --dart-define-from-file=.env
#
# EVERYTHING HERE SHIPS INSIDE THE APP. Anything compiled into an APK can be
# read back out of it, so this file holds public values only: a publishable key,
# never a secret key, a database URL or a token. CI rejects those, and the
# secrets setup collects go to `.env.tooling`, which is never read by the app.
#
# On an Android emulator, 127.0.0.1 is the emulator itself: use
# http://10.0.2.2:54321 for the local stack, or a hosted project's URL.

# Your Supabase project (setup writes both).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# The DevDogs course catalog (staging; the app never needs a key for it).
CATALOG_URL=https://api-staging.devdogsuga.org/catalog/v1

# Error reporting. Leave empty to send nothing.
SENTRY_DSN=
DEVDOGS_ENVIRONMENT=development
